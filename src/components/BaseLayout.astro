---
import '@fontsource/lilita-one';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '../styles/global.css';
import Icon from './Icon.astro';
import { SITE, NAV_LINKS, FOOTER_LINKS, TOOLS } from '@data/meta';

interface Props {
  title: string;
  description: string;
  /** Path with leading and trailing slash, e.g. "/upgrade-cost-calculator/". */
  canonical: string;
  noindex?: boolean;
  /** Extra JSON-LD objects (WebApplication, Organization, ...). */
  jsonLd?: unknown[];
  /** Active nav href for aria-current. */
  activeNav?: string;
}

const { title, description, canonical, noindex = false, jsonLd = [], activeNav } = Astro.props;

const fullCanonical = `${SITE.url}${canonical === '/' ? '' : canonical}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#2b5bd7" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the calculator</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label="CoCPlanner home">
          <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true">
            <path d="M32 4 56 12v18c0 14-9.6 24.8-24 30C17.6 54.8 8 44 8 30V12L32 4z" fill="#2b5bd7" stroke="#1e3fa0" stroke-width="3"></path>
            <path d="M32 14l12 4.5V32c0 8.4-5.2 14.6-12 17.6-6.8-3-12-9.2-12-17.6V18.5L32 14z" fill="#f0b429"></path>
            <rect x="29.5" y="24" width="5" height="16" rx="2" fill="#2b5bd7"></rect>
            <rect x="24" y="29.5" width="16" height="5" rx="2" fill="#2b5bd7"></rect>
          </svg>
          <span class="brand-name">CoC<span class="gold">Planner</span></span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {NAV_LINKS.map((link) => (
            <a href={link.href} aria-current={activeNav === link.href ? 'page' : undefined}>
              <Icon name={link.icon} size={15} strokeWidth={2.2} />
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <div class="footer-about">
          <h3><Icon name="shield" size={16} /> CoCPlanner</h3>
          <p class="small">
            Free Clash of Clans upgrade calculators. All math runs in your browser, nothing is uploaded,
            and every number traces back to the Clash of Clans Wiki.
          </p>
        </div>
        <div>
          <h3><Icon name="calculator" size={16} /> Calculators</h3>
          <ul>
            {TOOLS.map((t) => (
              <li><a href={t.slug}><Icon name={t.icon} size={14} /> {t.name}</a></li>
            ))}
            <li><a href="/cost-to-max/"><Icon name="table" size={14} /> Cost to Max Tables</a></li>
          </ul>
        </div>
        <div>
          <h3><Icon name="map" size={16} /> Site</h3>
          <ul>
            {FOOTER_LINKS.map((l) => (
              <li><a href={l.href}><Icon name={l.icon} size={14} /> {l.label}</a></li>
            ))}
            <li><a href="/guides/upgrade-priority/"><Icon name="book-open" size={14} /> Upgrade Priority Guide</a></li>
          </ul>
        </div>
        <p class="fine-print">
          CoCPlanner is a fan-made tool and is not affiliated with, endorsed by, sponsored by, or
          specifically approved by Supercell, and Supercell is not responsible for it. Clash of Clans
          is a trademark of Supercell Oy. See Supercell's fan content policy for details.
        </p>
      </div>
    </footer>
  </body>
</html>
