---
import Icon from './Icon.astro';

export interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq-item">
      <summary>
        <span class="faq-q">{item.q}</span>
        <span class="faq-toggle" aria-hidden="true"><Icon name="plus" size={15} strokeWidth={2.5} /></span>
      </summary>
      <div class="faq-body" set:html={item.a} />
    </details>
  ))}
</div>
