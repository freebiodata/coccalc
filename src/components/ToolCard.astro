---
import Icon from './Icon.astro';
import type { ToolMeta } from '@data/meta';
interface Props {
  tool: ToolMeta;
  headingLevel?: 'h2' | 'h3';
}
const { tool, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---
<a class="tool-card" href={tool.slug}>
  <span class="tool-icon"><Icon name={tool.icon} size={26} /></span>
  <Heading>{tool.name}</Heading>
  <p>{tool.short}</p>
  <span class="go">Open calculator <Icon name="arrow-right" size={15} /></span>
</a>
